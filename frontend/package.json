{
  "name": "misisync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types server.mjs --dev",
    "build": "next build",
    "start": "node --experimental-strip-types server.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import ./tests/register-css.mjs --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "lint": "eslint .",
    "format": "prettier --write app src tests server.mjs next.config.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
