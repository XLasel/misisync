PORT=3000
NUXT_API_BASE=http://backend:8000
REQUEST_TIMEOUT_SECONDS=60
MAX_DOWNLOAD_BYTES=31457280

# Live JSON-RPC from edu.misis.ru. Empty EDU_GROUPS = full filial catalog names.
EDU_API_URL=https://edu.misis.ru/schedule
EDU_FILIAL=MOSCOW
EDU_GROUPS=
EDU_REQUEST_DELAY_SECONDS=0.25
EDU_CATALOG_TTL_SECONDS=3600
EDU_SCHEDULE_TTL_SECONDS=900
EDU_SCHEDULE_CACHE_MAX_ENTRIES=256
# On failed refresh, keep the last response up to one hour after its TTL.
EDU_STALE_IF_ERROR_SECONDS=3600
EDU_RETRY_BACKOFF_SECONDS=30
EDU_MAX_PENDING_REQUESTS=64
EDU_MAX_CONCURRENT_REQUESTS=4
NUXT_SCHEDULE_RATE_LIMIT_PER_MINUTE=60
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
NUXT_TRUST_PROXY=false
