PORT=3000
NUXT_API_BASE=http://backend:8000
REQUEST_TIMEOUT_SECONDS=60
MAX_DOWNLOAD_BYTES=31457280

# Live JSON-RPC from edu.misis.ru. Empty EDU_GROUPS = full filial catalog names.
EDU_API_URL=https://edu.misis.ru/schedule
EDU_FILIAL=MOSCOW
EDU_GROUPS=
EDU_REQUEST_DELAY_SECONDS=0.25
EDU_CATALOG_TTL_SECONDS=3600
EDU_SCHEDULE_TTL_SECONDS=900
