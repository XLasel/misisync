PORT=3000
# Same frontend/API contract for both sources: excel | edu_api
SCHEDULE_SOURCE=excel
DATABASE_PATH=/data/schedule.sqlite3
NUXT_API_BASE=http://backend:8000
UPDATE_INTERVAL_SECONDS=14400
REQUEST_TIMEOUT_SECONDS=60
MAX_DOWNLOAD_BYTES=31457280
ENABLE_SCHEDULER=true
# Current Moscow calendar week and following weeks, maximum 12.
SYNC_WEEKS=4

# Excel adapter only. Academic week 1 contains EXCEL_TERM_START.
EXCEL_SOURCE_URL=https://misis.ru/students/
EXCEL_LINK_PATTERN=
EXCEL_UPPER_ROW_WEEK=odd
EXCEL_TERM_START=2026-09-01
EXCEL_TERM_END=2027-01-31

# JSON-RPC adapter only. Empty EDU_GROUPS imports the entire filial sequentially.
EDU_API_URL=https://edu.misis.ru/schedule
EDU_FILIAL=MOSCOW
EDU_GROUPS=МПИ-26-1-1,МПИ-26-1-2
EDU_REQUEST_DELAY_SECONDS=0.25
