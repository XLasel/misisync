# Host port: http://localhost:3000
PORT=3000
SOURCE_URL=https://misis.ru/students/
# Optional regex matching a file URL or its link label. Empty = all institutes.
SOURCE_LINK_PATTERN=
UPDATE_INTERVAL_SECONDS=14400
REQUEST_TIMEOUT_SECONDS=60
MAX_DOWNLOAD_BYTES=31457280
DATABASE_PATH=/data/misisync.sqlite3
ENABLE_SCHEDULER=true
# Top/bottom rows of two-row MISIS grids. odd = numerator on top.
UPPER_ROW_WEEK=odd
NUXT_API_BASE=http://backend:8000
